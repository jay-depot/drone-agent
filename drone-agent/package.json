{
  "name": "drone-agent",
  "version": "1.0.0",
  "description": "Local CLI runtime for the drone coding agent",
  "type": "module",
  "bin": {
    "drone-agent": "./bin/drone-agent",
    "drone-migrate": "./bin/drone-migrate"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./lib": {
      "types": "./dist/lib.d.ts",
      "import": "./dist/lib.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b --pretty false",
    "clean": "rm -rf dist tsconfig.tsbuildinfo",
    "test": "vitest run"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "drone-core": "workspace:*",
    "fast-glob": "^3.3.3",
    "ink": "^6.8.0",
    "ink-text-input": "^6.0.0",
    "lowlight": "^3.3.0",
    "marked": "^18.0.5",
    "node-pty": "^1.1.0",
    "ollama": "^0.6.0",
    "react": "^19.2.7",
    "tar": "^7.5.16"
  },
  "peerDependencies": {
    "react": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.17",
    "ink-testing-library": "^4.0.0"
  }
}
