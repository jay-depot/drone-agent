{
  "name": "drone-agent",
  "version": "1.0.0",
  "description": "Local CLI runtime for the drone coding agent",
  "type": "module",
  "bin": {
    "drone-agent": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./lib": {
      "types": "./dist/lib.d.ts",
      "import": "./dist/lib.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b --pretty false",
    "clean": "rm -rf dist tsconfig.tsbuildinfo"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "drone-core": "workspace:*",
    "ollama": "^0.6.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^11.8.0",
      "onFail": "download"
    }
  }
}
