{
  "name": "drone-ai",
  "version": "1.0.0",
  "private": true,
  "description": "Distributed coding agent monorepo",
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck && tsc -p tsconfig.test.json --pretty false",
    "clean": "pnpm -r run clean",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:integration": "docker compose -f docker/docker-compose.integration-test.yaml up --build --abort-on-container-exit --exit-code-from test-runner",
    "test:integration:vitest": "RUN_INTEGRATION_TESTS=true RUN_LSP_SMOKE_TESTS=true vitest run -c vitest.integration.config.ts",
    "docker:integration:up": "docker compose -f docker/docker-compose.integration-test.yaml up -d --build --scale test-runner=0",
    "docker:integration:down": "docker compose -f docker/docker-compose.integration-test.yaml down -v --remove-orphans",
    "docker:integration:run": "docker compose -f docker/docker-compose.integration-test.yaml run --rm test-runner",
    "docker:integration:test": "pnpm test:integration",
    "lint:eslint": "eslint . --ext .ts,.tsx --fix",
    "lint:prettier": "prettier --write .",
    "lint": "pnpm lint:eslint && pnpm lint:prettier",
    "docker:build": "docker compose -f docker/docker-compose.smoke-test.yaml build",
    "docker:up": "docker compose -f docker/docker-compose.smoke-test.yaml up -d",
    "docker:down": "docker compose -f docker/docker-compose.smoke-test.yaml down",
    "docker:smoke-test": "pnpm docker:build && pnpm docker:up && pnpm docker:smoke-test:run",
    "docker:smoke-test:run": "docker compose -f docker/docker-compose.smoke-test.yaml run --rm smoke-test-runner",
    "docker:clean": "docker compose -f docker/docker-compose.smoke-test.yaml down -v --remove-orphans"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "packageManager": "pnpm@11.8.0",
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.6",
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.13.3",
    "@typescript-eslint/eslint-plugin": "^8.68.0",
    "@typescript-eslint/parser": "^8.68.0",
    "eslint": "^10.9.1",
    "globals": "^17.11.0",
    "prettier": "^3.9.6",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  },
  "type": "module"
}
